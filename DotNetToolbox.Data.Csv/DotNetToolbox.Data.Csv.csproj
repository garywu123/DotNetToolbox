<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>GaryWu123.DotNetToolbox.Data.Csv</PackageId>
    <Authors>Gary Wu</Authors>
    <Description>Type-safe CSV reading and writing for internal .NET tools.</Description>
    <RepositoryUrl>https://github.com/garywu123/DotNetToolbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
