<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>GaryWu123.DotNetToolbox.Algorithms</PackageId>
    <Authors>Gary Wu</Authors>
    <Description>Reusable graph and geometry algorithms for internal .NET tools.</Description>
    <RepositoryUrl>https://github.com/garywu123/DotNetToolbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
